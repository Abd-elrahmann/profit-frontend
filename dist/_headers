# Headers للملفات الثابتة
# منع الـ cache لملفات HTML
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# السماح بالـ cache للملفات التي تحتوي على hash
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# منع الـ cache لملفات JavaScript و CSS بدون hash
/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.css
  Cache-Control: no-cache, no-store, must-revalidate
